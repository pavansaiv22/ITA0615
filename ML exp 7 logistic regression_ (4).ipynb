    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "\n",
    "\n",
    "# Sample dataset\n",
    "\n",
    "X = [[1], [2], [3], [4], [5], [6]]\n",
    "\n",
    "y = [0, 0, 0, 1, 1, 1]\n",
    "\n",
    "\n",
    "\n",
    "model = LogisticRegression()\n",
    "\n",
    "model.fit(X, y)\n",
    "\n",
    "\n",
    "\n",
    "pred = model.predict([[3.5]])\n",
    "\n",
    "\n",
    "\n",
    "print(\"Prediction:\", pred)"
   ]
  }
 ],
